<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Warcasket weapons become normal machining-table crafts with quality. VFE Pirates is a hard dependency, so no gate. -->
  <!-- Quality comp on all warcasket weapons. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@Name="VFEP_BaseWarcasketGun"]</xpath>
    <value>
      <comps>
        <li>
          <compClass>CompQuality</compClass>
        </li>
      </comps>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[@Name="VFEP_BaseMeleeWeapon_Warcasket"]</xpath>
    <value>
      <comps>
        <li>
          <compClass>CompQuality</compClass>
        </li>
      </comps>
    </value>
  </Operation>

  <!-- Craft at the machining table. Replaces the bases' nulled recipeMaker; -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="VFEP_BaseWarcasketGun"]/recipeMaker</xpath>
    <value>
      <recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
          <li>TableMachining</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
        <researchPrerequisite>VFEP_WarcasketWeaponry</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="VFEP_BaseMeleeWeapon_Warcasket"]/recipeMaker</xpath>
    <value>
      <recipeMaker>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <recipeUsers>
          <li>TableMachining</li>
        </recipeUsers>
        <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
        <researchPrerequisite>VFEP_WarcasketWeaponry</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <!-- VFE Pirates ships extra warcasket weapons in 1.6/Mods/<mod> folders that
       load only when the matching Vanilla Weapons Expanded mod is active. The
       warbolter (VWE Bioferrite) keeps its cost on the box only, so give the
       weapon the box's cost list and its extra research gate. Ordered before
       the fallback below so it stays craftable. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VWEB_Warbolter"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VWEB_Warbolter"]</xpath>
      <value>
        <costList>
          <Steel>320</Steel>
          <Plasteel>20</Plasteel>
          <Bioferrite>20</Bioferrite>
          <ComponentIndustrial>12</ComponentIndustrial>
        </costList>
        <recipeMaker>
          <researchPrerequisites>
            <li>BioferriteIgnition</li>
          </researchPrerequisites>
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- These two boxes were gated behind spacer-tier research; keep that
       gating on the recipes (child recipeMaker fields override the base's). -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_ChargeLance"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite>VFEP_SpacerWarcasketWeaponry</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_ChargeBlaster"]</xpath>
    <value>
      <recipeMaker>
        <researchPrerequisite>VFEP_SpacerWarcasketWeaponry</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <!-- Research gates from the remaining conditional weapons' boxes. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_Railgun"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_Railgun"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite>VWE_MassDrivers</researchPrerequisite>
          <researchPrerequisites>
            <li>VFEP_SpacerWarcasketWeaponry</li>
          </researchPrerequisites>
        </recipeMaker>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_TearGasGrenadeLauncher"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_TearGasGrenadeLauncher"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite>VWE_NonLethal</researchPrerequisite>
        </recipeMaker>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_FoldingGun"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_FoldingGun"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite>VWE_Quickdraw</researchPrerequisite>
        </recipeMaker>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_SalvagedLaserEradicator"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_SalvagedLaserEradicator"]</xpath>
      <value>
        <recipeMaker>
          <researchPrerequisite>VWE_LaserWeapons</researchPrerequisite>
        </recipeMaker>
      </value>
    </match>
  </Operation>

  <!-- Warcasket weapons that never had a weapon box are exotic trader/reward
       stock by design (plasma sword; crypto cannon from VFE Vikings; laser
       blaster from VWE Laser). Keep them uncraftable — they still roll
       quality when generated. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_PlasmaSword"]</xpath>
    <value>
      <recipeMaker Inherit="False" IsNull="True"/>
    </value>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_CryptoCannon"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_CryptoCannon"]</xpath>
      <value>
        <recipeMaker Inherit="False" IsNull="True"/>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_LaserBlaster"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="VFEP_WarcasketGun_LaserBlaster"]</xpath>
      <value>
        <recipeMaker Inherit="False" IsNull="True"/>
      </value>
    </match>
  </Operation>

  <!-- Fallback for any warcasket weapon from a mod not accounted for above:
       an inherited recipeMaker with no cost list is a config error, so leave
       those uncraftable. Skips defs handled above (they now have a costList
       or their own recipeMaker), so no duplicate nodes. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(@ParentName="VFEP_BaseWarcasketGun" or @ParentName="VFEP_BaseMeleeWeapon_Warcasket") and not(costList) and not(costStuffCount) and not(recipeMaker)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[(@ParentName="VFEP_BaseWarcasketGun" or @ParentName="VFEP_BaseMeleeWeapon_Warcasket") and not(costList) and not(costStuffCount) and not(recipeMaker)]</xpath>
      <value>
        <recipeMaker Inherit="False" IsNull="True"/>
      </value>
    </match>
  </Operation>


  <!-- ===== Stuffable melee weapons =====-->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_CombatKnife"]/costList</xpath>
    <value>
      <costStuffCount>140</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_CombatKnife"]</xpath>
    <value>
      <stuffCategories>
        <li>Metallic</li>
      </stuffCategories>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_Broadsword"]/costList</xpath>
    <value>
      <costStuffCount>270</costStuffCount>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_Broadsword"]</xpath>
    <value>
      <stuffCategories>
        <li>Metallic</li>
      </stuffCategories>
    </value>
  </Operation>

  <!-- The hammer's plasteel/uranium/spacer components stay fixed ingredients;
       only its steel frame becomes the stuff. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_GravityHammer"]/costList/Steel</xpath>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="VFEP_WarcasketMeleeWeapon_GravityHammer"]</xpath>
    <value>
      <costStuffCount>120</costStuffCount>
      <stuffCategories>
        <li>Metallic</li>
      </stuffCategories>
    </value>
  </Operation>


  <!-- Warcaskets: Adeptus Astartes adds three more melee weapons -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_PowerSword"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_PowerSword"]/costList/Steel</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_PowerSword"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_PowerSword"]</xpath>
      <value>
        <costStuffCount>150</costStuffCount>
        <stuffCategories>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ChainSword"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ChainSword"]/costList/Steel</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ChainSword"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ChainSword"]</xpath>
      <value>
        <costStuffCount>140</costStuffCount>
        <stuffCategories>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ThunderHammer"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ThunderHammer"]/costList/Steel</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ThunderHammer"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="HP_WarcasketMeleeWeapon_ThunderHammer"]</xpath>
      <value>
        <costStuffCount>140</costStuffCount>
        <stuffCategories>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>

  <!-- Unique Melee Weapons adds unique versions of the broadsword and gravity hammer,
       parented on the VFEP weapons. They inherit the stuff cost above, but declare
       <comps Inherit="False"> (they must swap CompEquippable for their own ability
       comp), which drops the CompQuality this mod puts on the base. Give it back,
       in the same place and with the same art gate as UMW's other uniques: Odyssey's
       CompUniqueWeapon then rolls them Super quality like every other unique, and
       only Excellent-plus ones get an inscription. Each op skips a def that already
       has the node, in case UMW adds it itself later. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[(defName="UMW_WarcasketBroadsword_Unique" or defName="UMW_WarcasketGravityHammer_Unique") and not(comps/li[compClass="CompQuality"])]/comps/li[@Class="CompProperties_Art"]</xpath>
    <match Class="PatchOperationInsert">
      <xpath>Defs/ThingDef[(defName="UMW_WarcasketBroadsword_Unique" or defName="UMW_WarcasketGravityHammer_Unique") and not(comps/li[compClass="CompQuality"])]/comps/li[@Class="CompProperties_Art"]</xpath>
      <order>Prepend</order>
      <value>
        <li>
          <compClass>CompQuality</compClass>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="UMW_WarcasketBroadsword_Unique" or defName="UMW_WarcasketGravityHammer_Unique"]/comps/li[@Class="CompProperties_Art" and not(minQualityForArtistic)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="UMW_WarcasketBroadsword_Unique" or defName="UMW_WarcasketGravityHammer_Unique"]/comps/li[@Class="CompProperties_Art" and not(minQualityForArtistic)]</xpath>
      <value>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </value>
    </match>
  </Operation>

  <!-- Retire the weapon boxes: -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="VFEP_WarcasketWeaponBoxBase"]/designationCategory</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="VFEP_WarcasketWeaponBoxBase"]/designatorDropdown</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[@Name="VFEP_WarcasketWeaponBoxBase"]/thingSetMakerTags</xpath>
  </Operation>
</Patch>
